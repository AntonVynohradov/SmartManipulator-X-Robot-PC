{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docs: Build PDF",
            "type": "process",
            "command": "bash",
            "args": [
                "tools/docs/build_pdf.sh"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "tools/docs/build_pdf.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docs: Live preview",
            "type": "process",
            "command": "bash",
            "args": [
                "tools/docs/build_pdf.sh",
                "--serve"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "tools/docs/build_pdf.ps1",
                    "-Serve"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
